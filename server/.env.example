PORT=5000
# MongoDB connection. Local: mongodb://127.0.0.1:27017/modliving
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/modliving
MONGODB_URI=mongodb://127.0.0.1:27017/modliving
# Admin login (used only the first time, to create data/admin.json).
# Change the password from Admin panel > Account afterwards.
ADMIN_EMAIL=admin@modliving.com
ADMIN_PASSWORD=Admin@123
# Long random string. If empty, one is generated and saved in data/.secret
JWT_SECRET=
# Extra origins allowed to call the API (only needed when client/admin are hosted on other domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
